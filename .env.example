# AI Hub 자격증명 — .gitignore 가 막고 있습니다 (커밋 안 됩니다)
#
# 여기 = 값을 붙여넣는 곳. 따옴표 없이, 공백 없이.
#   AIHUB_API_KEY=abcd1234...
#
# 쓰는 법:
#   set -a; . ./.env; set +a
#   uv run python prepare_local.py --chunk VL01
#
# ⚠️ 코드나 노트북 셀에는 절대 붙여넣지 마세요.
#    src/env.py 의 secret() 이 환경변수에서만 읽고 로그에서 마스킹합니다.

AIHUB_API_KEY=여기에_키를_넣으세요
